# Copy this file to ".env" and fill in your values. ".env" is git-ignored.

# --- Devices (use the IP printed on the Arduino Serial Monitor if .local names do not resolve) ---
ESP32_URL=http://plantrail.local
ESP32_API_KEY=change-me
CAM_URL=http://plantcam.local
# Browser-side stream URL (port 81 on the camera board). Leave empty to use snapshot polling only.
CAM_STREAM_URL=http://plantcam.local:81/stream

# --- AI disease diagnosis ---
# auto = Google Gemini if GEMINI_API_KEY is set (FREE tier), else Claude if ANTHROPIC_API_KEY is set, else demo.
# Other values: gemini | claude | demo
AI_PROVIDER=auto
# Free key: https://aistudio.google.com/apikey  (note: Google may use free-tier prompts/photos to improve its products)
GEMINI_API_KEY=
# Leave empty to use the newest "flash" model your key can use
GEMINI_MODEL=
# Optional paid alternative
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Answer language of the AI: bn = Bangla, en = English (the website also has a switch)
AI_LANGUAGE=bn
# Automatic camera scan every N hours (0 = off; each scan is a paid API call)
AUTO_SCAN_HOURS=0

# --- Server ---
HOST=0.0.0.0
PORT=8000
# 1 = simulated device + camera so you can try the website without hardware
MOCK_DEVICE=0
